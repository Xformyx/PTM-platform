# =============================================================================
# PTM Analysis Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed
# =============================================================================

# ─── General ─────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# API server (Docker): false = no uvicorn --reload (quieter logs; use in production)
UVICORN_RELOAD=true

# Docker Compose GPU overlay (docker-compose.gpu.yml)
# - auto: NVIDIA runtime 있으면 사용 (Mac Studio = false, RTX Windows/WSL = true)
# - true / false: 강제 on/off
COMPOSE_GPU=auto

# ─── Authentication ──────────────────────────────────────────────────────────
# Set to true for production/portal mode, false for internal use
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ptm_platform
MYSQL_USER=ptm_user
MYSQL_PASSWORD=ptm_password_change_me
MYSQL_ROOT_PASSWORD=ptm_root_password_change_me
DATABASE_URL=mysql+asyncmy://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_URL=http://${CHROMADB_HOST}:${CHROMADB_PORT}

# ─── LLM Configuration ───────────────────────────────────────────────────────
# Provider priority: auto = Ollama → OpenAI → Gemini (first available wins)
LLM_PROVIDER=auto
LLM_MODEL=gemma3:27b

# Ollama (Local LLM)
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_URL=http://${OLLAMA_HOST}:${OLLAMA_PORT}

# Cloud LLM fallback (used when Ollama is unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

# ─── MCP Server ──────────────────────────────────────────────────────────────
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://${MCP_SERVER_HOST}:${MCP_SERVER_PORT}

# ─── External PTM-CoScientist (Discussion Evidence Packet) ───────────────────
# Keep false unless the Co-Scientist API is reachable and intentionally enabled.
# When false, report generation never calls the external service.
COSCIENTIST_ENABLED=false
COSCIENTIST_BASE_URL=http://ptm-coscientist-api:8080
COSCIENTIST_API_URL=http://ptm-coscientist-api:8080
COSCIENTIST_MAX_HYPOTHESES=2
COSCIENTIST_REQUEST_TIMEOUT_SECONDS=20

# ─── External API Keys ──────────────────────────────────────────────────────
NCBI_EMAIL=your-email@example.com
NCBI_API_KEY=
STRINGDB_API_KEY=
# BioGRID protein-protein interactions. Without this the MCP biogrid tool returns
# "BIOGRID_API_KEY not configured" and contributes no interaction evidence.
# Free academic key: https://webservice.thebiogrid.org/
BIOGRID_API_KEY=

# ─── API Server ──────────────────────────────────────────────────────────────
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8000

# Docker SDK read timeout for PTMQuant container log streaming / wait() (seconds).
# Omit for ~7-day default in code — avoids UnixHTTP Read timed out (read timeout=60).
#DOCKER_CLIENT_TIMEOUT_SECONDS=604800

# diaquant `--engine` fallback when job config.yaml has no ``search_engine`` (legacy retries).
# New jobs store alphadia|sage in config.yaml via the UI.
# PTMQuant 폴백 엔진 (config.yaml에 search_engine 없는 구버전 작업·재실행 전용). sage로 바꿀 수 있음.
#PTMQUANT_DIAQUANT_ENGINE=alphadia

# Leave failed ptmquant containers on disk (exited) so `docker logs <id>` works.
# Retry/remove-stale still deletes the old container before starting a new run.
#PTMQUANT_KEEP_CONTAINER_ON_FAILURE=true

# AlphaDIA worker thread count (general.thread_count in AlphaDIA YAML).
# Each worker thread holds a partial copy of the speclib in memory, so
# peak RAM during library build and DecoyGenerator ≈ N × per-thread size.
# Leave empty to auto-calculate from the job's max_memory_gb (recommended).
# Override here to apply a global cap regardless of the per-job setting.
#
# Memory-tier guide (set in job request OR here as a global floor):
# ─────────────────────────────────────────────────────────────
#  Docker VM   │ Container limit  │ Recommended alphadia_threads
# ─────────────┼──────────────────┼─────────────────────────────
#   ≤  64 GB   │   ≤ 48 GB        │  PTMQUANT_ALPHADIA_THREADS=2
#   ≤  96 GB   │   ≤ 80 GB        │  PTMQUANT_ALPHADIA_THREADS=4   ← current Mac Studio
#   ≤ 128 GB   │  ≤ 112 GB        │  PTMQUANT_ALPHADIA_THREADS=6
#   > 128 GB   │  ≤ 192 GB+       │  (leave empty — auto is fine)
# ─────────────────────────────────────────────────────────────
# To run on a large server without any thread cap: set to 0 (AlphaDIA auto).
#PTMQUANT_ALPHADIA_THREADS=4

# ─── File Storage ────────────────────────────────────────────────────────────
INPUT_DIR=/app/data/inputs
REPORTS_DIR=/app/storage/reports
REFERENCE_DIR=/app/data/reference
LOG_DIR=/app/storage/logs

# ─── Webhook (Order events → OpenClaw, Slack, etc.) ────────────────────────────
# Comma-separated URLs. Events: started, completed, failed
WEBHOOK_URL=

# ─── Email (Notifications) ────────────────────────────────────────────────────
# Leave SMTP_HOST empty to disable email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ptm-platform.local
SMTP_USE_TLS=true

# ─── Worker Concurrency ─────────────────────────────────────────────────────
PREPROCESSING_CONCURRENCY=2
RAG_ENRICHMENT_CONCURRENCY=3
REPORT_GENERATION_CONCURRENCY=2
