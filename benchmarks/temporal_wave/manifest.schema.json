{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Temporal Wave Benchmark Manifest v1",
  "type": "object",
  "required": ["schema_version", "dataset_id", "data_path", "known_targets", "input_columns"],
  "properties": {
    "schema_version": {"const": "temporal_wave_benchmark_manifest.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "data_path": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_doi": {"type": "string"},
    "known_targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_target_windows": {"type": "object"},
    "input_columns": {
      "type": "object",
      "required": ["gene", "site", "timepoint", "log2fc", "candidate_kinases"],
      "additionalProperties": {"type": "string"}
    },
    "wave_config": {"type": "object"},
    "time_permutation": {"type": "object"},
    "threshold_sensitivity": {"type": "object"}
  },
  "additionalProperties": true
}
